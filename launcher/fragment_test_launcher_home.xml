<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TEST LAUNCHER"
            android:textSize="30sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Minecraft Java Edition • Android"
            android:textSize="15sp"
            android:paddingBottom="20dp" />

        <Button
            android:id="@+id/test_play"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="PLAY MINECRAFT" />

        <Button
            android:id="@+id/test_account"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="ACCOUNT • Offline / Microsoft" />

        <Button
            android:id="@+id/test_versions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="VERSIONS • Vanilla / Fabric / Forge / OptiFine" />

        <Button
            android:id="@+id/test_downloads"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="DOWNLOADS / INSTANCES" />

        <Button
            android:id="@+id/test_mods"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="MODS • Modrinth / CurseForge / SpigotMC" />

        <Button
            android:id="@+id/test_settings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="RAM / RENDERER / JAVA SETTINGS" />

        <Button
            android:id="@+id/test_controls"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="TOUCH CONTROLS" />

        <Button
            android:id="@+id/test_worlds"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="WORLDS" />

        <Button
            android:id="@+id/test_resourcepacks"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="RESOURCE PACKS" />

    </LinearLayout>
</ScrollView>
